{
    "manifest_version": 3,
    "name" : "Tab Grab",
    "version" : "1.0",
    "description" : "Bookmarking but BETTER",
    "action": {
        "default_popup": "popup/popup.html"
    },
    "icons" : {
        "128" : "images/browserIcon.png"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "permissions": [
        "storage",
        "alarms",
        "tabs",
        "notifications",
        "contextMenus"
    ],
    "host_permissions": [
        "http://localhost:3000/*"
    ]
}